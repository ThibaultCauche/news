// Schéma généré au J1 (docs/04-jalons.md). Modèle générique Événement / Compétition
// / Entité (docs/03-architecture-backend.md §2) : aucune table propre à un jeu ou
// un sport (règle 3 de CLAUDE.md).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Category {
  id           String        @id @default(uuid())
  slug         String        @unique
  name         String
  icon         String?
  competitions Competition[]

  @@map("category")
}

model Competition {
  id         String        @id @default(uuid())
  categoryId String        @map("category_id")
  category   Category      @relation(fields: [categoryId], references: [id])
  parentId   String?       @map("parent_id")
  parent     Competition?  @relation("CompetitionHierarchy", fields: [parentId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  children   Competition[] @relation("CompetitionHierarchy")
  kind       String
  name       String
  format     String?
  status     String?
  startsAt   DateTime?     @map("starts_at")
  endsAt     DateTime?     @map("ends_at")
  structure  Json?
  importance Int           @default(0)
  // Vrai si le fournisseur expose un bracket pour ce tournoi (has_bracket PandaScore) :
  // sert à cibler le job "structure" (J5) sans appeler /brackets sur tout le catalogue.
  hasBracket Boolean       @default(false) @map("has_bracket")
  events     Event[]
  standings  Standing[]
  createdAt  DateTime      @default(now()) @map("created_at")
  updatedAt  DateTime      @updatedAt @map("updated_at")

  @@map("competition")
}

model Entity {
  id           String             @id @default(uuid())
  kind         String
  name         String
  shortName    String?            @map("short_name")
  parentId     String?            @map("parent_id")
  parent       Entity?            @relation("EntityHierarchy", fields: [parentId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  children     Entity[]           @relation("EntityHierarchy")
  region       String?
  imageUrl     String?            @map("image_url")
  participants     EventParticipant[]
  standings        Standing[]
  notificationLogs NotificationLog[]
  createdAt        DateTime           @default(now()) @map("created_at")
  updatedAt        DateTime           @updatedAt @map("updated_at")

  @@map("entity")
}

model Event {
  id               String             @id @default(uuid())
  competitionId    String             @map("competition_id")
  competition      Competition        @relation(fields: [competitionId], references: [id])
  kind             String
  name             String
  status           String
  startsAt         DateTime?          @map("starts_at")
  endsAt           DateTime?          @map("ends_at")
  bestOf           Int?               @map("best_of")
  result           Json?
  importance       Int                @default(0)
  spoilerSensitive Boolean            @default(true) @map("spoiler_sensitive")
  participants     EventParticipant[]
  linksFrom        EventLink[]        @relation("EventLinkFrom")
  linksTo          EventLink[]        @relation("EventLinkTo")
  notificationLogs NotificationLog[]
  createdAt        DateTime           @default(now()) @map("created_at")
  updatedAt        DateTime           @updatedAt @map("updated_at")

  @@map("event")
}

model EventParticipant {
  id       String   @id @default(uuid())
  eventId  String   @map("event_id")
  event    Event    @relation(fields: [eventId], references: [id])
  entityId String   @map("entity_id")
  entity   Entity   @relation(fields: [entityId], references: [id])
  side     Int?
  score    Int?
  isWinner Boolean? @map("is_winner")
  seed     Int?

  @@unique([eventId, entityId])
  @@map("event_participant")
}

// Liens de bracket ("le vainqueur de A va en B"). Table créée au J1, peuplée au J5.
model EventLink {
  id          String @id @default(uuid())
  fromEventId String @map("from_event_id")
  fromEvent   Event  @relation("EventLinkFrom", fields: [fromEventId], references: [id])
  toEventId   String @map("to_event_id")
  toEvent     Event  @relation("EventLinkTo", fields: [toEventId], references: [id])
  outcome     String
  slot        Int?

  // Un match a au plus un lien "winner" et un lien "loser" sortants : clé naturelle
  // pour l'upsert idempotent (règle 4 de CLAUDE.md).
  @@unique([fromEventId, outcome])
  @@map("event_link")
}

// Classements et groupes. Table créée au J1, peuplée au J5/J6.
model Standing {
  id            String      @id @default(uuid())
  competitionId String      @map("competition_id")
  competition   Competition @relation(fields: [competitionId], references: [id])
  entityId      String      @map("entity_id")
  entity        Entity      @relation(fields: [entityId], references: [id])
  rank          Int?
  wins          Int?
  losses        Int?
  livesLeft     Int?        @map("lives_left")
  qualified     Boolean?

  @@unique([competitionId, entityId])
  @@map("standing")
}

// "Pourquoi ce match compte", glossaire, textes de contexte (docs/03 §2/§7, J6).
// `text` peut contenir des mots repérés `[[terme]]` que l'appli transforme en lien
// vers la feuille glossaire (écran 04). Clé naturelle pour l'upsert idempotent
// (règle 4 de CLAUDE.md) : un seul texte par cible et par genre de contenu.
model ContextSnippet {
  id          String   @id @default(uuid())
  targetType  String   @map("target_type")
  targetId    String   @map("target_id")
  kind        String
  text        String
  source      String?
  license     String?
  generatedBy String   @map("generated_by")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@unique([targetType, targetId, kind])
  @@map("context_snippet")
}

// Lien avec les objets externes, clé de l'ingestion idempotente (règle 4 de CLAUDE.md).
model ProviderRef {
  id           String   @id @default(uuid())
  objectType   String   @map("object_type")
  objectId     String   @map("object_id")
  provider     String
  externalId   String   @map("external_id")
  lastSyncedAt DateTime @map("last_synced_at")
  payloadHash  String   @map("payload_hash")

  @@unique([provider, objectType, externalId])
  @@map("provider_ref")
}

// Réponses brutes des fournisseurs, gardées 7 jours pour déboguer (docs/03 §3).
model ProviderPayload {
  id         String   @id @default(uuid())
  provider   String
  objectType String   @map("object_type")
  externalId String   @map("external_id")
  payload    Json
  fetchedAt  DateTime @default(now()) @map("fetched_at")

  @@map("provider_payload")
}

// Compte anonyme créé au premier lancement (J4, docs/03 §2/§4). Pas d'inscription ;
// un lien Apple/Google pour synchroniser plusieurs appareils viendra plus tard.
model AppUser {
  id               String            @id @default(uuid())
  devices          Device[]
  subscriptions    Subscription[]
  setting          UserSetting?
  notificationLogs NotificationLog[]
  createdAt        DateTime          @default(now()) @map("created_at")

  @@map("app_user")
}

// Un appareil par installation (`installId` généré une fois côté client). `liveActivityToken`
// réservé pour la V2 (Live Activities iOS, docs/03 §5), pas encore utilisé.
model Device {
  id                String   @id @default(uuid())
  userId            String   @map("user_id")
  user              AppUser  @relation(fields: [userId], references: [id], onDelete: Cascade)
  installId         String   @map("install_id")
  pushToken         String?  @map("push_token")
  platform          String
  locale            String?
  // Décalage UTC en minutes (ex. 120 = UTC+2), pas un nom de fuseau IANA :
  // seul consommateur au J4 est le calcul des heures calmes (arithmétique pure,
  // pas de base de données de fuseaux côté appli).
  utcOffsetMinutes  Int?     @map("utc_offset_minutes")
  liveActivityToken String?  @map("live_activity_token")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  @@unique([userId, installId])
  @@map("device")
}

// Suivi d'une catégorie, compétition, entité ou événement (docs/03 §2/§6).
// `level` distingue "tout" (ex. G2 : chaque match) de "key_moments" (ex. Valorant :
// seulement les grands moments), les résolutions hiérarchiques (catégorie/compétition
// parente) se font au moment de la notification, pas ici.
model Subscription {
  id             String   @id @default(uuid())
  userId         String   @map("user_id")
  user           AppUser  @relation(fields: [userId], references: [id], onDelete: Cascade)
  targetType     String   @map("target_type")
  targetId       String   @map("target_id")
  level          String   @default("all")
  notifyReminder Boolean  @default(true) @map("notify_reminder")
  notifyStart    Boolean  @default(true) @map("notify_start")
  notifyResult   Boolean  @default(true) @map("notify_result")
  createdAt      DateTime @default(now()) @map("created_at")

  @@unique([userId, targetType, targetId])
  @@map("subscription")
}

// Réglages appliqués côté serveur (règle 10 de CLAUDE.md : les notifications
// masquent le score sans spoil, contrairement à l'affichage qui est démasquable
// côté appli). `spoilerFree` reste global (une seule vraie catégorie avec des
// données pour l'instant, J6) : la granularité par catégorie de l'écran 22
// attendra une 2e catégorie. `morningDigest` est le réglage seul (J6) ; l'envoi
// réel du résumé n'est pas encore construit (pas de contenu "3 points" à envoyer).
model UserSetting {
  id              String   @id @default(uuid())
  userId          String   @unique @map("user_id")
  user            AppUser  @relation(fields: [userId], references: [id], onDelete: Cascade)
  spoilerFree     Boolean  @default(true) @map("spoiler_free")
  morningDigest   Boolean  @default(false) @map("morning_digest")
  quietHoursStart Int?     @map("quiet_hours_start")
  quietHoursEnd   Int?     @map("quiet_hours_end")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@map("user_setting")
}

// Journal des notifications envoyées, clé de déduplication (userId, eventId, type) —
// règle 4 de CLAUDE.md appliquée aux notifications : on n'envoie jamais deux fois.
// Deux chemins de déduplication (règle 4 de CLAUDE.md) : par match (rappel/début/
// résultat) ou par entité (qualification/élimination, J5 — pas de match unique
// derrière un changement de classement). `eventId`/`entityId` sont donc tous les
// deux optionnels, mais toujours l'un ou l'autre en pratique.
model NotificationLog {
  id       String   @id @default(uuid())
  userId   String   @map("user_id")
  user     AppUser  @relation(fields: [userId], references: [id], onDelete: Cascade)
  eventId  String?  @map("event_id")
  event    Event?   @relation(fields: [eventId], references: [id])
  entityId String?  @map("entity_id")
  entity   Entity?  @relation(fields: [entityId], references: [id])
  type     String
  sentAt   DateTime @default(now()) @map("sent_at")

  @@unique([userId, eventId, type])
  @@unique([userId, entityId, type])
  @@map("notification_log")
}
