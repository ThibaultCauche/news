// Schéma généré au J1 (docs/04-jalons.md). Modèle générique Événement / Compétition
// / Entité (docs/03-architecture-backend.md §2) : aucune table propre à un jeu ou
// un sport (règle 3 de CLAUDE.md).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Category {
  id           String        @id @default(uuid())
  slug         String        @unique
  name         String
  icon         String?
  competitions Competition[]

  @@map("category")
}

// Toutes les éditions d'une même compétition d'une ligue (docs/04 J10) : suivre la
// famille « Champions » de VCT couvre Champions 2026 et les suivantes. Nom dérivé de
// celui de la série (`familyNameOf`, packages/domain).
model CompetitionFamily {
  id           String        @id @default(uuid())
  leagueId     String        @map("league_id")
  league       Competition   @relation("LeagueFamilies", fields: [leagueId], references: [id])
  name         String
  competitions Competition[] @relation("FamilyCompetitions")

  @@unique([leagueId, name])
  @@map("competition_family")
}

model Competition {
  id         String        @id @default(uuid())
  categoryId String        @map("category_id")
  category   Category      @relation(fields: [categoryId], references: [id])
  parentId   String?       @map("parent_id")
  parent     Competition?  @relation("CompetitionHierarchy", fields: [parentId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  children   Competition[] @relation("CompetitionHierarchy")
  // Famille de la série (« Champions » pour Champions 2025/2026…), null hors série (J10).
  familyId   String?       @map("family_id")
  family     CompetitionFamily? @relation("FamilyCompetitions", fields: [familyId], references: [id])
  // Familles d'une ligue (côté ligue racine).
  families   CompetitionFamily[] @relation("LeagueFamilies")
  kind       String
  // Slug du jeu (ex. "valorant"), null hors e-sport : sert à regrouper les ligues
  // par jeu dans l'onglet Compétitions (J9). Champ, pas une table (règle 3).
  game       String?
  // Logo fourni par le fournisseur (ligues PandaScore) ; sert de logo de jeu (J9).
  imageUrl   String?       @map("image_url")
  name       String
  format     String?
  status     String?
  startsAt   DateTime?     @map("starts_at")
  endsAt     DateTime?     @map("ends_at")
  structure  Json?
  importance Int           @default(0)
  // Vrai si le fournisseur expose un bracket pour ce tournoi (has_bracket PandaScore) :
  // sert à cibler le job "structure" (J5) sans appeler /brackets sur tout le catalogue.
  hasBracket Boolean       @default(false) @map("has_bracket")
  events     Event[]
  standings  Standing[]
  favorites  FavoriteCompetition[]
  createdAt  DateTime      @default(now()) @map("created_at")
  updatedAt  DateTime      @updatedAt @map("updated_at")

  @@map("competition")
}

model Entity {
  id           String             @id @default(uuid())
  kind         String
  name         String
  shortName    String?            @map("short_name")
  parentId     String?            @map("parent_id")
  parent       Entity?            @relation("EntityHierarchy", fields: [parentId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  children     Entity[]           @relation("EntityHierarchy")
  region       String?
  imageUrl     String?            @map("image_url")
  participants     EventParticipant[]
  standings        Standing[]
  notificationLogs NotificationLog[]
  createdAt        DateTime           @default(now()) @map("created_at")
  updatedAt        DateTime           @updatedAt @map("updated_at")

  @@map("entity")
}

model Event {
  id               String             @id @default(uuid())
  competitionId    String             @map("competition_id")
  competition      Competition        @relation(fields: [competitionId], references: [id])
  kind             String
  name             String
  status           String
  startsAt         DateTime?          @map("starts_at")
  endsAt           DateTime?          @map("ends_at")
  bestOf           Int?               @map("best_of")
  result           Json?
  // Chaînes de diffusion de l'éditeur (PandaScore `streams_list`, filtrées par `pickPublisherStreams`), J21.
  streams          Json?
  importance       Int                @default(0)
  spoilerSensitive Boolean            @default(true) @map("spoiler_sensitive")
  participants     EventParticipant[]
  linksFrom        EventLink[]        @relation("EventLinkFrom")
  linksTo          EventLink[]        @relation("EventLinkTo")
  notificationLogs NotificationLog[]
  predictions      Prediction[]
  createdAt        DateTime           @default(now()) @map("created_at")
  updatedAt        DateTime           @updatedAt @map("updated_at")

  @@map("event")
}

// Profil Twitch d'une chaîne de diffusion (J21) : logo, nom affiché et « en direct ». Rempli par le worker
// (API Twitch), jamais par l'appli (règle 1).
model StreamChannel {
  login            String    @id
  displayName      String?   @map("display_name")
  imageUrl         String?   @map("image_url")
  live             Boolean   @default(false)
  profileCheckedAt DateTime? @map("profile_checked_at")
  liveCheckedAt    DateTime? @map("live_checked_at")

  @@map("stream_channel")
}

model EventParticipant {
  id       String   @id @default(uuid())
  eventId  String   @map("event_id")
  event    Event    @relation(fields: [eventId], references: [id])
  entityId String   @map("entity_id")
  entity   Entity   @relation(fields: [entityId], references: [id])
  side     Int?
  score    Int?
  isWinner Boolean? @map("is_winner")
  seed     Int?

  @@unique([eventId, entityId])
  @@map("event_participant")
}

// Liens de bracket ("le vainqueur de A va en B"). Table créée au J1, peuplée au J5.
model EventLink {
  id          String @id @default(uuid())
  fromEventId String @map("from_event_id")
  fromEvent   Event  @relation("EventLinkFrom", fields: [fromEventId], references: [id])
  toEventId   String @map("to_event_id")
  toEvent     Event  @relation("EventLinkTo", fields: [toEventId], references: [id])
  outcome     String
  slot        Int?

  // Un match a au plus un lien "winner" et un lien "loser" sortants : clé naturelle
  // pour l'upsert idempotent (règle 4 de CLAUDE.md).
  @@unique([fromEventId, outcome])
  @@map("event_link")
}

// Classements et groupes. Table créée au J1, peuplée au J5/J6.
model Standing {
  id            String      @id @default(uuid())
  competitionId String      @map("competition_id")
  competition   Competition @relation(fields: [competitionId], references: [id])
  entityId      String      @map("entity_id")
  entity        Entity      @relation(fields: [entityId], references: [id])
  rank          Int?
  wins          Int?
  losses        Int?
  livesLeft     Int?        @map("lives_left")
  qualified     Boolean?

  @@unique([competitionId, entityId])
  @@map("standing")
}

// "Pourquoi ce match compte", glossaire, textes de contexte (docs/03 §2/§7, J6).
// `text` peut contenir des mots repérés `[[terme]]` que l'appli transforme en lien
// vers la feuille glossaire (écran 04). Clé naturelle pour l'upsert idempotent
// (règle 4 de CLAUDE.md) : un seul texte par cible et par genre de contenu.
model ContextSnippet {
  id          String   @id @default(uuid())
  targetType  String   @map("target_type")
  targetId    String   @map("target_id")
  kind        String
  text        String
  source      String?
  license     String?
  generatedBy String   @map("generated_by")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@unique([targetType, targetId, kind])
  @@map("context_snippet")
}

// Lien avec les objets externes, clé de l'ingestion idempotente (règle 4 de CLAUDE.md).
model ProviderRef {
  id           String   @id @default(uuid())
  objectType   String   @map("object_type")
  objectId     String   @map("object_id")
  provider     String
  externalId   String   @map("external_id")
  lastSyncedAt DateTime @map("last_synced_at")
  payloadHash  String   @map("payload_hash")

  @@unique([provider, objectType, externalId])
  @@map("provider_ref")
}

// Réponses brutes des fournisseurs, gardées 7 jours pour déboguer (docs/03 §3).
model ProviderPayload {
  id         String   @id @default(uuid())
  provider   String
  objectType String   @map("object_type")
  externalId String   @map("external_id")
  payload    Json
  fetchedAt  DateTime @default(now()) @map("fetched_at")

  @@map("provider_payload")
}

// Compte Firebase Auth (e-mail + mot de passe), J11 : l'invité navigue sans compte, tout le
// reste exige d'être connecté. `firebaseUid` est nullable seulement pour les tests qui
// créent des utilisateurs directement en base. Le pseudo n'existe qu'après « créer mon
// profil » ; `pseudoKey` (minuscules, sans accents) porte l'unicité.
model AppUser {
  id               String              @id @default(uuid())
  firebaseUid      String?             @unique @map("firebase_uid")
  emailVerified    Boolean             @default(false) @map("email_verified")
  pseudo           String?
  pseudoKey        String?             @unique @map("pseudo_key")
  pseudoChangedAt  DateTime?           @map("pseudo_changed_at")
  // Avatar = logo d'une équipe (`entity`) d'un des jeux de l'appli : pas d'envoi de photo.
  avatarEntityId   String?             @map("avatar_entity_id")
  devices          Device[]
  subscriptions    Subscription[]
  setting          UserSetting?
  notificationLogs NotificationLog[]
  favoriteGames    FavoriteGame[]
  favoriteCompetitions FavoriteCompetition[]
  predictions      Prediction[]
  learnProgress    LearnProgress[]
  ownedGroups      FriendGroup[]
  groupMemberships FriendGroupMember[]
  // Forum (J13) : modérateur et bêta fermée (posés à la main en base), exclusion du forum,
  // acceptation des conditions d'utilisation (version du texte embarqué dans l'appli).
  isModerator      Boolean             @default(false) @map("is_moderator")
  forumBeta        Boolean             @default(false) @map("forum_beta")
  forumBannedAt    DateTime?           @map("forum_banned_at")
  termsAcceptedAt  DateTime?           @map("terms_accepted_at")
  termsVersion     Int?                @map("terms_version")
  forumThreads     ForumThread[]
  forumMessages    ForumMessage[]
  forumReactions   ForumReaction[]
  forumReports     ForumReport[]
  forumCamps       ForumCamp[]
  forumFollows     ForumThreadFollow[]
  moderationLogs   ModerationLog[]
  blocking         UserBlock[]         @relation("Blocker")
  blockedBy        UserBlock[]         @relation("Blocked")
  createdAt        DateTime            @default(now()) @map("created_at")

  @@map("app_user")
}

// Progression dans les tutos (J12) : un tuto ouvert, et son quiz réussi ou non. Générique : `guide`
// est le nom du fichier de tutos (`valorant`, `app`…), aucune colonne propre à un jeu (règle 3).
// Pas de points : un simple compteur affiché sur le profil.
model LearnProgress {
  userId      String   @map("user_id")
  user        AppUser  @relation(fields: [userId], references: [id], onDelete: Cascade)
  guide       String
  articleId   String   @map("article_id")
  quizPassed  Boolean  @default(false) @map("quiz_passed")
  firstReadAt DateTime @default(now()) @map("first_read_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@id([userId, guide, articleId])
  @@map("learn_progress")
}

// Pronostic en points fictifs (J11) : vainqueur choisi + score de série optionnel, posé jusqu'au
// début du match. `points` reste nul tant que le match n'est pas terminé (le worker le remplit
// une seule fois). Générique : aucune colonne propre à un jeu (règle 3).
model Prediction {
  id              String    @id @default(uuid())
  userId          String    @map("user_id")
  user            AppUser   @relation(fields: [userId], references: [id], onDelete: Cascade)
  eventId         String    @map("event_id")
  event           Event     @relation(fields: [eventId], references: [id], onDelete: Cascade)
  pickedEntityId  String    @map("picked_entity_id")
  // Score de série prédit, du point de vue de l'entité choisie (ex. 2-1).
  pickedScore     Int?      @map("picked_score")
  otherScore      Int?      @map("other_score")
  points          Int?
  settledAt       DateTime? @map("settled_at")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  @@unique([userId, eventId])
  @@index([eventId])
  @@map("prediction")
}

// Groupe d'amis (J11) : rejoint par un code de 8 caractères (alphabet sans ambiguïté).
model FriendGroup {
  id        String              @id @default(uuid())
  name      String
  code      String              @unique
  ownerId   String              @map("owner_id")
  owner     AppUser             @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  members   FriendGroupMember[]
  createdAt DateTime            @default(now()) @map("created_at")

  @@map("friend_group")
}

model FriendGroupMember {
  groupId   String      @map("group_id")
  group     FriendGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  userId    String      @map("user_id")
  user      AppUser     @relation(fields: [userId], references: [id], onDelete: Cascade)
  joinedAt  DateTime    @default(now()) @map("joined_at")

  @@id([groupId, userId])
  @@index([userId])
  @@map("friend_group_member")
}

// Jeu mis en favori (J9) : simple raccourci d'accès, sans notification. Séparé de
// `subscription`, qui est hiérarchique (suivre une ligue notifierait tout le jeu).
model FavoriteGame {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  user      AppUser  @relation(fields: [userId], references: [id], onDelete: Cascade)
  game      String
  createdAt DateTime @default(now()) @map("created_at")

  @@unique([userId, game])
  @@map("favorite_game")
}

// Compétition mise en favori (J20) : raccourci d'accès uniquement (section « Favoris » de l'onglet
// Compétitions), jamais de notification : `subscription` reste le seul lieu des alertes.
model FavoriteCompetition {
  id            String      @id @default(uuid())
  userId        String      @map("user_id")
  user          AppUser     @relation(fields: [userId], references: [id], onDelete: Cascade)
  competitionId String      @map("competition_id")
  competition   Competition @relation(fields: [competitionId], references: [id], onDelete: Cascade)
  createdAt     DateTime    @default(now()) @map("created_at")

  @@unique([userId, competitionId])
  @@map("favorite_competition")
}

// Un appareil par installation (`installId` généré une fois côté client). `liveActivityToken`
// réservé pour la V2 (Live Activities iOS, docs/03 §5), pas encore utilisé.
model Device {
  id                String   @id @default(uuid())
  userId            String   @map("user_id")
  user              AppUser  @relation(fields: [userId], references: [id], onDelete: Cascade)
  installId         String   @map("install_id")
  pushToken         String?  @map("push_token")
  platform          String
  locale            String?
  // Décalage UTC en minutes (ex. 120 = UTC+2), pas un nom de fuseau IANA :
  // seul consommateur au J4 est le calcul des heures calmes (arithmétique pure,
  // pas de base de données de fuseaux côté appli).
  utcOffsetMinutes  Int?     @map("utc_offset_minutes")
  liveActivityToken String?  @map("live_activity_token")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  @@unique([userId, installId])
  @@map("device")
}

// Suivi d'une catégorie, compétition, entité ou événement (docs/03 §2/§6).
// `level` distingue "tout" (ex. G2 : chaque match) de "key_moments" (ex. Valorant :
// seulement les grands moments), les résolutions hiérarchiques (catégorie/compétition
// parente) se font au moment de la notification, pas ici.
model Subscription {
  id             String   @id @default(uuid())
  userId         String   @map("user_id")
  user           AppUser  @relation(fields: [userId], references: [id], onDelete: Cascade)
  targetType     String   @map("target_type")
  targetId       String   @map("target_id")
  level          String   @default("all")
  notifyReminder Boolean  @default(true) @map("notify_reminder")
  notifyStart    Boolean  @default(true) @map("notify_start")
  notifyResult   Boolean  @default(true) @map("notify_result")
  // Sourdine (J10, compétitions seulement) : « je suis la ligue, sauf celle-ci ». La règle
  // la plus proche du match l'emporte (`nearestCompetitionRule`, packages/domain).
  muted          Boolean  @default(false)
  createdAt      DateTime @default(now()) @map("created_at")

  @@unique([userId, targetType, targetId])
  @@map("subscription")
}

// Réglages appliqués côté serveur (règle 10 de CLAUDE.md : les notifications
// masquent le score sans spoil, contrairement à l'affichage qui est démasquable
// côté appli). `spoilerFree` reste global (une seule vraie catégorie avec des
// données pour l'instant, J6) : la granularité par catégorie de l'écran 22
// attendra une 2e catégorie. `morningDigest` est le réglage seul (J6) ; l'envoi
// réel du résumé n'est pas encore construit (pas de contenu "3 points" à envoyer).
model UserSetting {
  id              String   @id @default(uuid())
  userId          String   @unique @map("user_id")
  user            AppUser  @relation(fields: [userId], references: [id], onDelete: Cascade)
  spoilerFree     Boolean  @default(false) @map("spoiler_free")
  morningDigest   Boolean  @default(false) @map("morning_digest")
  quietHoursStart Int?     @map("quiet_hours_start")
  quietHoursEnd   Int?     @map("quiet_hours_end")
  // Forum (J13) : notification quand on répond à un de ses messages.
  notifyForumReplies Boolean @default(true) @map("notify_forum_replies")
  // Forum (J13) : nouveaux messages d'une discussion suivie.
  notifyForumThreads Boolean @default(true) @map("notify_forum_threads")
  // J14 : réglage global par type de notification, en plus des options de chaque suivi.
  notifyMatchReminder      Boolean @default(true) @map("notify_match_reminder")
  notifyMatchStart         Boolean @default(true) @map("notify_match_start")
  notifyMatchResult        Boolean @default(true) @map("notify_match_result")
  notifyQualification      Boolean @default(true) @map("notify_qualification")
  notifyPredictionReminders Boolean @default(true) @map("notify_prediction_reminders")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@map("user_setting")
}

// Journal des notifications envoyées, clé de déduplication (userId, eventId, type) —
// règle 4 de CLAUDE.md appliquée aux notifications : on n'envoie jamais deux fois.
// Deux chemins de déduplication (règle 4 de CLAUDE.md) : par match (rappel/début/
// résultat) ou par entité (qualification/élimination, J5 — pas de match unique
// derrière un changement de classement). `eventId`/`entityId` sont donc tous les
// deux optionnels, mais toujours l'un ou l'autre en pratique.
model NotificationLog {
  id       String   @id @default(uuid())
  userId   String   @map("user_id")
  user     AppUser  @relation(fields: [userId], references: [id], onDelete: Cascade)
  eventId  String?  @map("event_id")
  event    Event?   @relation(fields: [eventId], references: [id])
  entityId String?  @map("entity_id")
  entity   Entity?  @relation(fields: [entityId], references: [id])
  type     String
  sentAt   DateTime @default(now()) @map("sent_at")

  @@unique([userId, eventId, type])
  @@unique([userId, entityId, type])
  @@map("notification_log")
}

// Fil de discussion (J13). Créé à la demande : un fil par match (`event`), équipe (`entity`),
// compétition, jeu (`targetId` = slug), ou libre (`free`, créé par un utilisateur). `game` (slug)
// sert au badge de camp et au filtre. Générique : aucune colonne propre à un jeu (règle 3).
model ForumThread {
  id            String         @id @default(uuid())
  kind          String
  targetId      String?        @map("target_id")
  game          String?
  title         String
  createdById   String?        @map("created_by_id")
  createdBy     AppUser?       @relation(fields: [createdById], references: [id], onDelete: SetNull)
  lockedAt      DateTime?      @map("locked_at")
  lastMessageAt DateTime?      @map("last_message_at")
  messages      ForumMessage[]
  followers     ForumThreadFollow[]
  createdAt     DateTime       @default(now()) @map("created_at")

  @@unique([kind, targetId])
  @@index([game, lastMessageAt])
  @@map("forum_thread")
}

// Message texte seul. Une seule profondeur de réponse : `parentId` désigne toujours un message
// racine. `hiddenAt` masque sans supprimer (signalements ou modérateur) ; la suppression du compte
// supprime ses messages (RGPD), les réponses des autres restent (parent mis à null).
model ForumMessage {
  id           String          @id @default(uuid())
  threadId     String          @map("thread_id")
  thread       ForumThread     @relation(fields: [threadId], references: [id], onDelete: Cascade)
  userId       String          @map("user_id")
  user         AppUser         @relation(fields: [userId], references: [id], onDelete: Cascade)
  parentId     String?         @map("parent_id")
  parent       ForumMessage?   @relation("Replies", fields: [parentId], references: [id], onDelete: SetNull)
  replies      ForumMessage[]  @relation("Replies")
  body         String
  hiddenAt     DateTime?       @map("hidden_at")
  hiddenReason String?         @map("hidden_reason")
  // Modification dans les 5 minutes, spoiler annoncé par l'auteur (flouté pour tous), épinglé (modérateur).
  editedAt     DateTime?       @map("edited_at")
  isSpoiler    Boolean         @default(false) @map("is_spoiler")
  pinnedAt     DateTime?       @map("pinned_at")
  reactions    ForumReaction[]
  reports      ForumReport[]
  createdAt    DateTime        @default(now()) @map("created_at")

  @@index([threadId, createdAt])
  @@index([userId])
  @@map("forum_message")
}

// Une réaction par personne et par message (changer de réaction remplace la précédente).
model ForumReaction {
  messageId String       @map("message_id")
  message   ForumMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  userId    String       @map("user_id")
  user      AppUser      @relation(fields: [userId], references: [id], onDelete: Cascade)
  emoji     String
  createdAt DateTime     @default(now()) @map("created_at")

  @@id([messageId, userId])
  @@map("forum_reaction")
}

model ForumReport {
  id         String       @id @default(uuid())
  messageId  String       @map("message_id")
  message    ForumMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  reporterId String       @map("reporter_id")
  reporter   AppUser      @relation(fields: [reporterId], references: [id], onDelete: Cascade)
  reason     String
  resolvedAt DateTime?    @map("resolved_at")
  createdAt  DateTime     @default(now()) @map("created_at")

  @@unique([messageId, reporterId])
  @@index([resolvedAt])
  @@map("forum_report")
}

// Blocage : les messages du bloqué disparaissent pour celui qui bloque.
model UserBlock {
  blockerId String   @map("blocker_id")
  blocker   AppUser  @relation("Blocker", fields: [blockerId], references: [id], onDelete: Cascade)
  blockedId String   @map("blocked_id")
  blocked   AppUser  @relation("Blocked", fields: [blockedId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now()) @map("created_at")

  @@id([blockerId, blockedId])
  @@map("user_block")
}

// Camp (badge du forum) : une équipe par jeu, changeable tous les 7 jours (`changedAt`).
model ForumCamp {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  user      AppUser  @relation(fields: [userId], references: [id], onDelete: Cascade)
  game      String
  entityId  String   @map("entity_id")
  changedAt DateTime @default(now()) @map("changed_at")

  @@unique([userId, game])
  @@map("forum_camp")
}

// Discussion suivie (J13) : notification des nouveaux messages, au plus une toutes les 10 minutes
// par discussion (`lastNotifiedAt`), pour ne pas inonder un fil du direct.
model ForumThreadFollow {
  threadId       String      @map("thread_id")
  thread         ForumThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  userId         String      @map("user_id")
  user           AppUser     @relation(fields: [userId], references: [id], onDelete: Cascade)
  lastNotifiedAt DateTime?   @map("last_notified_at")
  createdAt      DateTime    @default(now()) @map("created_at")

  @@id([threadId, userId])
  @@index([userId])
  @@map("forum_thread_follow")
}

// Journal de modération (J13) : qui a fait quoi, quand. `detail` garde un extrait du message
// concerné (il peut être supprimé ensuite) ; le modérateur supprimé laisse une ligne anonyme.
model ModerationLog {
  id           String    @id @default(uuid())
  moderatorId  String?   @map("moderator_id")
  moderator    AppUser?  @relation(fields: [moderatorId], references: [id], onDelete: SetNull)
  action       String
  targetUserId String?   @map("target_user_id")
  messageId    String?   @map("message_id")
  threadId     String?   @map("thread_id")
  detail       String?
  createdAt    DateTime  @default(now()) @map("created_at")

  @@index([createdAt])
  @@map("moderation_log")
}
