# Copier en .env et remplir. Ne jamais commiter .env.

# Fournisseurs de données
PANDASCORE_TOKEN=
LIQUIPEDIA_USER_AGENT="News/0.1 (contact: votre-email@example.com)"

# Base de données et cache
DATABASE_URL=postgresql://news:news@localhost:5432/news
REDIS_URL=redis://localhost:6379

# Authentification (J4)
JWT_SECRET=
JWT_REFRESH_SECRET=

# Notifications push (J4) et comptes Firebase Auth e-mail/mot de passe (J11, vérification des ID tokens par l'API)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Supervision (J7)
SENTRY_DSN=
# Webhook texte pour les alertes de supervision (ntfy.sh ou équivalent) ; vide = pas d'envoi, log seul.
ALERT_WEBHOOK_URL=

# Mise en ligne (J7) : uniquement sur le NAS, pas en dev.
# Mot de passe Postgres de prod (docker-compose.yml en dérive DATABASE_URL).
# `openssl rand -hex 24`, pas -base64 : un / ou + généré casserait l'URL
# postgresql://... (vécu : erreur Prisma P1013 "invalid port number").
POSTGRES_PASSWORD=
# ghcr.io/<compte-github>/news — sinon l'image est reconstruite localement plutôt que tirée de GHCR.
IMAGE=
# Laisser VIDE avec Tailscale Funnel (docs/05 §3) : il retire déjà le
# préfixe de chemin avant de relayer vers l'API. Ne sert que derrière un
# reverse proxy qui, lui, ne le retire pas (l'API répondrait sinon à la
# racine et 404 sur tout ce qui arrive préfixé).
PUBLIC_PATH_PREFIX=

# Forum (J13) : "true" ouvre le forum a tous ; sinon reserve aux comptes app_user.forum_beta (bete fermee)
FORUM_OPEN=

# Versions de l'appli (J21) : `latest` = bandeau « mise à jour conseillée », `minSupported` = écran bloquant. Vides = 1.0.0.
APP_LATEST_VERSION=
APP_MIN_SUPPORTED_VERSION=
APP_UPDATE_NOTES=
# Message de service (J17) : bandeau fermable chez tous les utilisateurs, vide = aucun.
APP_MESSAGE=

# Twitch (J21) : logos et « en direct » des chaînes de diffusion. Application sur dev.twitch.tv/console (type Confidentiel). Vides = initiales, sans « en direct ».
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# start.gg (J27) : jeux de combat (Smash Ultimate). Token personnel (start.gg > Developer Settings), un seul token par produit. Vide = jeu non ingéré.
STARTGG_TOKEN=

# Jolpica-F1 (J28) : sans clé ; le contact ci-dessus (LIQUIPEDIA_USER_AGENT) est envoyé comme User-Agent.
